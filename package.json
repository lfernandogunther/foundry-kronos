{
  "name": "foundry-kronos",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Foundry VTT v14 calendar, time and weather toolbar for Pathfinder 2e",
  "scripts": {
    "build": "vite build && node tools/package.mjs",
    "dev": "vite build --watch",
    "harness": "vite --config vite.harness.config.ts --open /tools/harness/index.html",
    "install:foundry": "npm run build && node tools/install.mjs",
    "release": "npm run build && node tools/release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
